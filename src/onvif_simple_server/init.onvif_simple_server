#!/bin/bash

set -e

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

ensure_symlink()
{
    local TARGET=$1
    local LINK=$2

    ln -sfn "$TARGET" "$LINK"
}

rm -rf ./_install

FETCH="$SCRIPT_DIR/../../scripts/fetch.sh"

$FETCH crypt-1.18.2.tar.xz 96ad4c3b8336050993c5bc2cf6c057484f2b0f9f763448151567fbab5e767b84 \
    https://github.com/libtom/libtomcrypt/releases/download/v1.18.2/crypt-1.18.2.tar.xz
tar Jxvf ./crypt-1.18.2.tar.xz
ensure_symlink libtomcrypt-1.18.2 libtomcrypt
ensure_symlink ../../libtomcrypt-1.18.2 onvif_simple_server/extras/libtomcrypt

MBEDTLS_VERSION=3.6.5
MBEDTLS_NAME=mbedtls-3.6.5
$FETCH ${MBEDTLS_NAME}.tar.bz2 4a11f1777bb95bf4ad96721cac945a26e04bf19f57d905f241fe77ebeddf46d8 \
    https://github.com/Mbed-TLS/mbedtls/releases/download/${MBEDTLS_NAME}/${MBEDTLS_NAME}.tar.bz2
tar xvf ./${MBEDTLS_NAME}.tar.bz2
ensure_symlink ${MBEDTLS_NAME} mbedtls
ensure_symlink ../../${MBEDTLS_NAME} onvif_simple_server/extras/mbedtls
cp -f mbedtls_config.h mbedtls/include/mbedtls/

WOLFSSL_VERSION=v5.9.2-stable
WOLFSSL_DIR=wolfssl-5.9.2-stable
$FETCH ${WOLFSSL_VERSION}.tar.gz 2f4ef3d4fd387a9b3191d36a6316d69116c46ff69bb9583b6c82b36d7b8ca114 \
    https://github.com/wolfSSL/wolfssl/archive/refs/tags/${WOLFSSL_VERSION}.tar.gz
tar zxf ./${WOLFSSL_VERSION}.tar.gz
ensure_symlink ${WOLFSSL_DIR} wolfssl
ensure_symlink ../../${WOLFSSL_DIR} onvif_simple_server/extras/wolfssl

# zlib.net only keeps the newest version (older ones answer with an HTML page),
# so GitHub first, zlib.net/fossils as fallback
$FETCH zlib-1.3.2.tar.gz bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16 \
    https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz \
    https://www.zlib.net/fossils/zlib-1.3.2.tar.gz \
    https://www.zlib.net/zlib-1.3.2.tar.gz
tar zxf ./zlib-1.3.2.tar.gz
ensure_symlink zlib-1.3.2 zlib
ensure_symlink ../../zlib-1.3.2 onvif_simple_server/extras/zlib

$FETCH json-c-0.18.tar.gz 876ab046479166b869afc6896d288183bbc0e5843f141200c677b3e8dfb11724 \
    https://s3.amazonaws.com/json-c_releases/releases/json-c-0.18.tar.gz \
    https://github.com/json-c/json-c/archive/refs/tags/json-c-0.18-20240915.tar.gz
tar zxf ./json-c-0.18.tar.gz
ensure_symlink json-c-0.18 json-c
ensure_symlink ../../json-c-0.18 onvif_simple_server/extras/json-c
mkdir -p json-c/build

cd onvif_simple_server

git reset --hard

patch -p1 < ../path.patch
